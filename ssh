# FIREWALLFALCON
#
Port 22
Protocol 2 
KeyRegenerationInterval 3600 
ServerKeyBits 1024 
SyslogFacility AUTH 
LogLevel INFO 
LoginGraceTime 120 
PermitRootLogin yes 
StrictModes yes 
RSAAuthentication no 
PubkeyAuthentication no 
IgnoreRhosts yes 
RhostsRSAAuthentication no 
HostbasedAuthentication no 
PermitEmptyPasswords no 
PermitTunnel yes 
PasswordAuthentication yes 
X11Forwarding no 
X11DisplayOffset 10 
PrintMotd no 
PrintLastLog no 
TCPKeepAlive no 

#UseLogin no 
AcceptEnv LANG LC_* 
Subsystem sftp /usr/lib/openssh/sftp-server 
UsePAM no
Banner /etc/bannerssh

# HTTP CUSTOM
KexAlgorithms +duffie-hellman-group14-shal
HostKeyAlgorithms +ssh-rsa
PubkeyAcceptedAlgorithms +ssh-rsa
Ciphers aes128-ctr

# CLIENT ALIVE

ClientAliveInterval 5
ClientAliveCountMax 5

# DNS
useDNS no
GSSAPIAuthentication no
